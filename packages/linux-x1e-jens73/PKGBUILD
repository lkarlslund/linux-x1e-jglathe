# Rename the existing 7.3 package without leaving two installed variants.
package_linux-x1e-jens73() {
  _package
  replaces=(linux-x1e-t14s-edge)
  conflicts=(linux-x1e-t14s-edge)
}

package_linux-x1e-jens73-headers() {
  _package-headers
  replaces=(linux-x1e-t14s-edge-headers)
  conflicts=(linux-x1e-t14s-edge-headers)
}

# This package installs only T14s DTBs. Other boards in this integration tree
# include missing files (for example x1-acer-swift-14.dtsi).
build() {
  cd "${_srcname}"
  make -j"$(nproc)" Image Image.gz modules \
    qcom/x1e78100-lenovo-thinkpad-t14s.dtb \
    qcom/x1e78100-lenovo-thinkpad-t14s-oled.dtb
  # The EL2 DTBs share x1-el2.dtbo and rebuild their base DTBs; building them
  # in parallel (makepkg exports MAKEFLAGS=-j) races on those outputs.
  make -j1 qcom/x1e78100-lenovo-thinkpad-t14s-el2.dtb \
    qcom/x1e78100-lenovo-thinkpad-t14s-oled-el2.dtb
}
