pkgbase=linux-x1e-jens73
pkgver=7.3.0
pkgrel=9

_variant_desc='Jens 7.3.0 Snapdragon laptop integration'
_kernel_repo='https://github.com/jglathe/linux_ms_dev_kit'
# Our changes are commits on github.com/lkarlslund/linux-x1e-t14s (t14s/jens-7.3, exp/*);
# set X1E_KERNEL_GIT (e.g. in ~/.makepkg.conf) to build from a local mirror instead.
_kernel_git="${X1E_KERNEL_GIT:-https://github.com/lkarlslund/linux-x1e-t14s.git}"
_commit='85211c98063b18700a9a95dda79aa95ab3a390fe'
_boot_title='Arch Linux — Jens 7.3'
_sort_key='40-x1e-jens73'
_module_baseline=none
_kernel_options='rw id_aa64mmfr0.ecv=1 id_aa64mmfr1.vh=0 quiet splash msm.psr_enabled=0'

_kernel_patches=()

source "${startdir}/../../common/kernel-package.inc"
source+=("${_kernel_patches[@]}" x1e-el2-sleep)
sha256sums+=(
  'a25218066cbad1f2ae30e7e4c48b768aa45221bdd1566e6263e0d7d4218b0e53'
)

# Replaces the old 7.3 edge package and the merged-in sleep test variant.
package_linux-x1e-jens73() {
  _package
  install -Dm755 "${srcdir}/x1e-el2-sleep" \
    "${pkgdir}/usr/lib/systemd/system-sleep/x1e-el2-sleep"
  replaces=(linux-x1e-t14s-edge linux-x1e-jens73-sleep)
  conflicts=(linux-x1e-t14s-edge linux-x1e-jens73-sleep)
}

package_linux-x1e-jens73-headers() {
  _package-headers
  replaces=(linux-x1e-t14s-edge-headers linux-x1e-jens73-sleep-headers)
  conflicts=(linux-x1e-t14s-edge-headers linux-x1e-jens73-sleep-headers)
}

# This package installs only T14s DTBs. Other boards in this integration tree
# include missing files (for example x1-acer-swift-14.dtsi).
build() {
  cd "${_srcname}"
  make -j"$(nproc)" Image Image.gz modules \
    qcom/x1e78100-lenovo-thinkpad-t14s.dtb \
    qcom/x1e78100-lenovo-thinkpad-t14s-oled.dtb
  # The EL2 DTBs share x1-el2.dtbo and rebuild their base DTBs; building them
  # in parallel (makepkg exports MAKEFLAGS=-j) races on those outputs.
  make -j1 qcom/x1e78100-lenovo-thinkpad-t14s-el2.dtb \
    qcom/x1e78100-lenovo-thinkpad-t14s-oled-el2.dtb
}
