pkgbase=linux-x1e-jens73
pkgver=7.3.rc7
pkgrel=1

_variant_desc='Jens 7.3-rc7 Snapdragon laptop integration'
_kernel_repo='https://github.com/jglathe/linux_ms_dev_kit'
_commit='b1482e1e1590306027ebf5ebd6d7df1ceab84ec5'
_boot_title='Arch Linux — Jens 7.3-rc7'
_sort_key='40-x1e-jens73'
_kernel_options='rw id_aa64mmfr0.ecv=1 quiet splash msm.psr_enabled=0'

_kernel_patches=(
  '0001-dispcc-x1e80100-keep-pll0.patch'
  '0002-battmgr-x1e80100-capacity.patch'
  '0003-battmgr-report-full.patch'
  '0004-battmgr-notify-charger-online.patch'
  '0005-t14s-pmic-thermal-zones.patch'
  '0006-t14s-ec-reset-reserved.patch'
)

source "${startdir}/../../common/kernel-package.inc"
source+=("${_kernel_patches[@]}")
