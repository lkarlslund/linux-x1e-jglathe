#!/bin/sh
# systemd-sleep hook for the linux-x1e-jens73 kernel.
#
# DRIPS is reached through s2idle (the system power domain's CPU_SUSPEND),
# not PSCI SYSTEM_SUSPEND, so switch the mode after systemd has written its
# MemorySleepMode, and keep the SoC out of AOSD (hourly resets reported on
# X1E at EL2). The firmware takes the APSS wake-up deadline from the arch
# timer, which the kernel parks with a valid CVAL when it is stopped.
#
# Once CX collapses, the firmware leaves the deepest state about every 31 s
# and edge-triggered PDC wake lines see a spurious edge: the D+ wake IRQ of
# the USB 2.0 controller that only carries the fingerprint reader, and with
# the lid open the lid GPIO. Keep that controller from waking the system, and
# drop lid wakeup while the lid is open (restored on resume).
# Other kernels are left alone.

case "$(uname -r)" in
	*-x1e-jens73-ARCH) ;;
	*) exit 0 ;;
esac

usb2_wake=/sys/devices/platform/soc@0/a200000.usb/power/wakeup
lid_wake=/sys/devices/platform/gpio-keys/power/wakeup
lid_state=/run/x1e-el2-sleep-lid-wake

lid_closed() {
	busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
		org.freedesktop.login1.Manager LidClosed 2>/dev/null | grep -q true
}

if [ "$1" = pre ] && [ "$2" = suspend ]; then
	echo s2idle > /sys/power/mem_sleep
	modprobe x1e_aoss_cxsd_only
	[ -w "$usb2_wake" ] && echo disabled > "$usb2_wake"
	if [ -w "$lid_wake" ] && ! lid_closed && [ "$(cat "$lid_wake")" = enabled ]; then
		echo disabled > "$lid_wake" && touch "$lid_state"
	fi
elif [ "$1" = post ] && [ -e "$lid_state" ]; then
	echo enabled > "$lid_wake"
	rm -f "$lid_state"
fi
exit 0
