#!/bin/sh
# systemd-sleep hook for the linux-x1e-jens73-sleep test kernel.
#
# DRIPS is reached through s2idle (the system power domain's CPU_SUSPEND),
# not PSCI SYSTEM_SUSPEND, so switch the mode after systemd has written its
# MemorySleepMode. Load the EL2 sleep helpers for the suspend and unload
# x1e_el1tmr afterwards: KVM owns the EL1 timers while guests run.
# Other kernels are left alone.

case "$(uname -r)" in
	*-x1e-jens73-sleep-*) ;;
	*) exit 0 ;;
esac

case "$1" in
	pre)
		[ "$2" = suspend ] || exit 0
		echo s2idle > /sys/power/mem_sleep
		modprobe x1e_aoss_cxsd_only
		# Fails with ENODEV when the kernel is not running at EL2.
		modprobe x1e_el1tmr || true
		;;
	post)
		modprobe -r x1e_el1tmr 2>/dev/null || true
		;;
esac
exit 0
