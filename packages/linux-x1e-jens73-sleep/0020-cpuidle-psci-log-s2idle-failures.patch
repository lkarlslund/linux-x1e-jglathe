From 017dc018715327d9c28d25382d2397920999929d Mon Sep 17 00:00:00 2001
From: Lars Karlslund <8929787+lkarlslund@users.noreply.github.com>
Subject: [PATCH] cpuidle: psci: Log raw s2idle domain suspend failures

---
diff --git a/drivers/cpuidle/cpuidle-psci.c b/drivers/cpuidle/cpuidle-psci.c
index b250d0dde760..536a079b1385 100644
--- a/drivers/cpuidle/cpuidle-psci.c
+++ b/drivers/cpuidle/cpuidle-psci.c
@@ -87,7 +87,11 @@ static __cpuidle int __psci_enter_domain_idle_state(struct cpuidle_device *dev,
 		state = ds->state;
 
 	trace_psci_domain_idle_enter(dev->cpu, state, s2idle);
-	ret = psci_cpu_suspend_enter(state) ? -1 : idx;
+	ret = psci_cpu_suspend_enter(state);
+	if (ret && s2idle && ds->state)
+		pr_warn_ratelimited("CPU%d: PSCI s2idle state %#x failed: %d\n",
+				    dev->cpu, state, ret);
+	ret = ret ? -1 : idx;
 	trace_psci_domain_idle_exit(dev->cpu, state, s2idle);
 
 	if (s2idle)
