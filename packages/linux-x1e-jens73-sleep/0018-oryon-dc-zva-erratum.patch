From: justririll (x1e-sleep)
Subject: [PATCH] arm64: errata: work around broken DC ZVA on Qualcomm Oryon X1

Code part of https://github.com/justririll/x1e-sleep
(kernel/experimental/x1-dc-zva-erratum-and-cl5.patch), also carried by
https://github.com/ramonjesusmiranda-debug/sp11-el2 (01-oryon-dc-zva-erratum).

DC ZVA misbehaves after the CL5 cluster state and can reset X1 SoCs (the
reason CL5 was dropped from the hamoa clusters). Never execute it: clear
SCTLR_ELx.DZE so EL0 sees DC ZVA as prohibited and emulate a trapped
DC ZVA, and skip it in clear_page, memset and the MTE tag helpers.
---
diff --git a/arch/arm64/include/asm/esr.h b/arch/arm64/include/asm/esr.h
index f816f5d77f1a..ed9869631a4d 100644
--- a/arch/arm64/include/asm/esr.h
+++ b/arch/arm64/include/asm/esr.h
@@ -256,6 +256,8 @@
 #define ESR_ELx_SYS64_ISS_CRM_DC_CVAU	11
 #define ESR_ELx_SYS64_ISS_CRM_DC_CVAC	10
 #define ESR_ELx_SYS64_ISS_CRM_IC_IVAU	5
+/* Not a CMO, but hey... */
+#define ESR_ELx_SYS64_ISS_CRM_DC_ZVA	4
 
 #define ESR_ELx_SYS64_ISS_EL0_CACHE_OP_MASK	(ESR_ELx_SYS64_ISS_OP0_MASK | \
 						 ESR_ELx_SYS64_ISS_OP1_MASK | \
diff --git a/arch/arm64/kernel/cpu_errata.c b/arch/arm64/kernel/cpu_errata.c
index e0c09402540c..34558e4118ec 100644
--- a/arch/arm64/kernel/cpu_errata.c
+++ b/arch/arm64/kernel/cpu_errata.c
@@ -674,6 +674,21 @@ static const struct midr_range cnp_erratum_cpus[] = {
 };
 #endif
 
+static const struct midr_range qcom_oryon_list[] = {
+	MIDR_ALL_VERSIONS(MIDR_QCOM_ORYON_X1),
+	{}
+};
+
+static bool qcom_oryon_has_broken_dc_zva(const struct arm64_cpu_capabilities *entry, int scope)
+{
+	return is_midr_in_range_list(qcom_oryon_list);
+}
+
+static void qcom_oryon_disable_dc_zva(const struct arm64_cpu_capabilities *__unused)
+{
+	sysreg_clear_set_s(SYS_SCTLR_EL1, SCTLR_EL1_DZE, 0);
+}
+
 const struct arm64_cpu_capabilities arm64_errata[] = {
 #ifdef CONFIG_ARM64_WORKAROUND_CLEAN_CACHE
 	{
@@ -1027,10 +1042,14 @@ const struct arm64_cpu_capabilities arm64_errata[] = {
 	{
 		.desc = "Broken CNTVOFF_EL2",
 		.capability = ARM64_WORKAROUND_QCOM_ORYON_CNTVOFF,
-		ERRATA_MIDR_RANGE_LIST(((const struct midr_range[]) {
-					MIDR_ALL_VERSIONS(MIDR_QCOM_ORYON_X1),
-					{}
-				})),
+		ERRATA_MIDR_RANGE_LIST(qcom_oryon_list),
+	},
+	{
+		.desc = "Broken DC ZVA",
+		.capability = ARM64_WORKAROUND_QCOM_ORYON_DC_ZVA,
+		.type = ARM64_CPUCAP_LOCAL_CPU_ERRATUM,
+		.matches = qcom_oryon_has_broken_dc_zva,
+		.cpu_enable = qcom_oryon_disable_dc_zva,
 	},
 	{
 		.desc = "Apple IMPDEF PMUv3 Traps",
diff --git a/arch/arm64/kernel/traps.c b/arch/arm64/kernel/traps.c
index 914282016069..383726b1d25e 100644
--- a/arch/arm64/kernel/traps.c
+++ b/arch/arm64/kernel/traps.c
@@ -558,6 +558,17 @@ void do_el1_mops(struct pt_regs *regs, unsigned long esr)
 		uaccess_ttbr0_disable();			\
 	}
 
+static int emulate_dc_zva(unsigned long address)
+{
+	void __user *va;
+	u64 bs;
+
+	bs = 4UL << (read_sysreg(DCZID_EL0) & 0xf);
+	va = (void __user *)(address & ~(bs - 1));
+
+	return copy_to_user(va, page_to_virt(ZERO_PAGE(0)), bs);
+}
+
 static void user_cache_maint_handler(unsigned long esr, struct pt_regs *regs)
 {
 	unsigned long tagged_address, address;
@@ -587,6 +598,9 @@ static void user_cache_maint_handler(unsigned long esr, struct pt_regs *regs)
 	case ESR_ELx_SYS64_ISS_CRM_IC_IVAU:	/* IC IVAU */
 		__user_cache_maint("ic ivau", address, ret);
 		break;
+	case ESR_ELx_SYS64_ISS_CRM_DC_ZVA:	/* DC ZVA */
+		ret = emulate_dc_zva(address);
+		break;
 	default:
 		force_signal_inject(SIGILL, ILL_ILLOPC, regs->pc, 0);
 		return;
diff --git a/arch/arm64/lib/clear_page.S b/arch/arm64/lib/clear_page.S
index bd6f7d5eb6eb..afc8c2d6ae3b 100644
--- a/arch/arm64/lib/clear_page.S
+++ b/arch/arm64/lib/clear_page.S
@@ -29,7 +29,7 @@ alternative_else_nop_endif
 .Lno_mops:
 #endif
 	mrs	x1, dczid_el0
-	tbnz	x1, #4, 2f	/* Branch if DC ZVA is prohibited */
+	b	2f		/* X1 CL5 erratum: never execute DC ZVA. */
 	and	w1, w1, #0xf
 	mov	x2, #4
 	lsl	x1, x2, x1
diff --git a/arch/arm64/lib/memset.S b/arch/arm64/lib/memset.S
index 97157da65ec6..d99ec7ea9d31 100644
--- a/arch/arm64/lib/memset.S
+++ b/arch/arm64/lib/memset.S
@@ -147,7 +147,7 @@ SYM_FUNC_START_LOCAL(__pi_memset_generic)
 	b.lt	.Lnot_short /*count is at least  128 bytes*/
 
 	mrs	tmp1, dczid_el0
-	tbnz	tmp1, #4, .Lnot_short
+	b	.Lnot_short	/* X1 CL5 erratum: never execute DC ZVA. */
 	mov	tmp3w, #4
 	and	zva_len, tmp1w, #15	/* Safety: other bits reserved.  */
 	lsl	zva_len, tmp3w, zva_len
diff --git a/arch/arm64/lib/mte.S b/arch/arm64/lib/mte.S
index 5018ac03b6bf..594ff9d1b9d9 100644
--- a/arch/arm64/lib/mte.S
+++ b/arch/arm64/lib/mte.S
@@ -45,7 +45,7 @@ SYM_FUNC_END(mte_clear_page_tags)
 SYM_FUNC_START(mte_zero_clear_page_tags)
 	and	x0, x0, #(1 << MTE_TAG_SHIFT) - 1	// clear the tag
 	mrs	x1, dczid_el0
-	tbnz	x1, #4, 2f	// Branch if DC GZVA is prohibited
+	b	2f		// X1 CL5 erratum: never execute DC GZVA
 	and	w1, w1, #0xf
 	mov	x2, #4
 	lsl	x1, x2, x1
diff --git a/arch/arm64/tools/cpucaps b/arch/arm64/tools/cpucaps
index 58b6c084f9f2..ea236bf0e8b1 100644
--- a/arch/arm64/tools/cpucaps
+++ b/arch/arm64/tools/cpucaps
@@ -127,6 +127,7 @@ WORKAROUND_NVIDIA_OLYMPUS_1027
 WORKAROUND_PMUV3_IMPDEF_TRAPS
 WORKAROUND_QCOM_FALKOR_E1003
 WORKAROUND_QCOM_ORYON_CNTVOFF
+WORKAROUND_QCOM_ORYON_DC_ZVA
 WORKAROUND_REPEAT_TLBI_SYNC
 WORKAROUND_SPECULATIVE_AT
 WORKAROUND_SPECULATIVE_SSBS
