#!/usr/bin/env bash
set -euo pipefail

variants=(
  linux-x1e-jens725-pdc
  linux-x1e-jens73
)

if [[ ${1-} == --all ]]; then
  printf '%s\n' "${variants[@]}"
  exit 0
fi

if (( $# != 0 )); then
  echo "Usage: $0 [--all]" >&2
  echo "Without --all, changed paths are read from standard input." >&2
  exit 2
fi

declare -A selected=()
select_all=false

while IFS= read -r path; do
  case "$path" in
    common/*|.github/workflows/kernel-packages.yml|scripts/select-kernel-packages)
      select_all=true
      ;;
    packages/linux-x1e-jens725-pdc/*)
      selected[linux-x1e-jens725-pdc]=1
      ;;
    packages/linux-x1e-jens73/*|packages/linux-x1e-t14s-edge/*)
      selected[linux-x1e-jens73]=1
      ;;
  esac
done

if [[ $select_all == true ]]; then
  printf '%s\n' "${variants[@]}"
  exit 0
fi

for variant in "${variants[@]}"; do
  if [[ ${selected[$variant]+yes} ]]; then
    printf '%s\n' "$variant"
  fi
done
