#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
all_variants=(
  linux-x1e-jens725-pdc
  linux-x1e-jens73
  linux-x1e-jens73-sleep
)

usage() {
  echo "Usage: $0 all|VARIANT [VARIANT ...]" >&2
  echo "Variants: ${all_variants[*]}" >&2
  echo "Source trees are reused between builds; set KERNEL_CLEANBUILD=1 to start from scratch." >&2
}

if (( $# == 0 )); then
  usage
  exit 2
fi

if [[ $1 == all ]]; then
  variants=("${all_variants[@]}")
  shift
  (( $# == 0 )) || { usage; exit 2; }
else
  variants=("$@")
fi

for variant in "${variants[@]}"; do
  package_dir="${repo_root}/packages/${variant}"
  if [[ ! -f ${package_dir}/PKGBUILD ]]; then
    echo "Unknown kernel variant: ${variant}" >&2
    usage
    exit 2
  fi

  echo "==> Building ${variant}"
  (
    cd "${package_dir}"
    # Reusing src/ avoids a full checkout and lets kbuild rebuild
    # incrementally; prepare() resets the tree to the pinned commit.
    clean_args=()
    [[ ${KERNEL_CLEANBUILD:-0} == 1 ]] && clean_args=(--cleanbuild --clean)
    makepkg --syncdeps "${clean_args[@]}"
  )
done
